{
    "version": 2,
    "builds": [
        {
            "src": "dinamita/src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "dinamita/src/index.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/dinamita/public/$1"
        }
    ]
}